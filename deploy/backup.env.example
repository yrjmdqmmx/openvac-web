# Install as /etc/openvac/backup.env with owner root:root and mode 0600.
# Do not put this file or populated values in Git.
BACKUP_RETENTION_DAYS=30
OSS_BACKUP_BUCKET=replace-with-private-backup-bucket
OSS_BACKUP_PREFIX=openvac/backups
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com

# Dedicated least-privilege RAM credentials. ossutil reads these only from env.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional for STS credentials.
OSS_SESSION_TOKEN=
