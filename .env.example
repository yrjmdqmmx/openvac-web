# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://openvac:openvac@127.0.0.1:5432/openvac
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Model provider (server only)
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled
MODEL_MAX_OUTPUT_TOKENS=4096

# Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
ALIBABA_EMBEDDING_MODEL=text-embedding-v4
ALIBABA_EMBEDDING_DIMENSIONS=1024
ALIBABA_WEB_SEARCH_ENABLED=false
ALIBABA_WEB_SEARCH_MODEL=qwen-plus
ALIBABA_WEB_SEARCH_PER_USER_DAILY_LIMIT=5
ALIBABA_WEB_SEARCH_GLOBAL_DAILY_LIMIT=500
ALIBABA_WEB_SEARCH_ALLOWED_DOMAINS=cds.cern.ch,nist.gov,hse.gov.uk,iso.org,leybold.com,leybold.cn,pfeiffer-vacuum.com,edwardsvacuum.com,buschvacuum.com,atlascopco.com
ALIBABA_OCR_ENDPOINT=
ALIBABA_OCR_ALLOWED_DOCUMENT_HOSTS=

# Alibaba Cloud DirectMail
ALIBABA_DIRECTMAIL_ACCESS_KEY_ID=
ALIBABA_DIRECTMAIL_ACCESS_KEY_SECRET=
ALIBABA_DIRECTMAIL_SECURITY_TOKEN=
ALIBABA_DIRECTMAIL_ACCOUNT_NAME=no-reply@mail.openvac.cn
ALIBABA_DIRECTMAIL_REGION=cn-hangzhou
ALIBABA_DIRECTMAIL_ENDPOINT=dm.aliyuncs.com

# Alibaba Cloud DocMind (use a separate least-privilege credential)
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_SECURITY_TOKEN=

# Alibaba Cloud OSS
ALIBABA_OSS_REGION=
ALIBABA_OSS_ENDPOINT=
ALIBABA_OSS_BUCKET=
ALIBABA_OSS_ACCESS_KEY_ID=
ALIBABA_OSS_ACCESS_KEY_SECRET=
ALIBABA_OSS_SECURITY_TOKEN=

# Product policy
ANSWER_DAILY_LIMIT=20
BACKUP_RETENTION_DAYS=30
ADMIN_BOOTSTRAP_EMAIL=
CONSULTATION_NOTIFICATION_EMAIL=
GEN_AI_FILING_NUMBER=
ALLOW_DEVELOPMENT_MOCKS=true
WORKER_CONCURRENCY=2
WORKER_LEASE_HEARTBEAT_MS=60000
WORKER_MAX_OCR_POLLS=240
WORKER_MAX_OCR_AGE_MS=7200000

# Deterministic CAD modeling service
# Keep false until the CAD, interoperability and pump acceptance gates pass.
MODELING_ENABLED=false
MODELING_SERVICE_URL=http://127.0.0.1:8080
MODELING_SERVICE_TOKEN=replace-with-an-independent-random-service-token
MODELING_GLOBAL_CONCURRENCY=1
MODELING_QUEUE_CAPACITY=20
MODELING_MAX_USER_RUNNING=1
MODELING_MAX_USER_QUEUED=2
MODELING_DAILY_COMPUTE_SECONDS=1200
MODELING_DAILY_EXPORT_LIMIT=10
MODELING_OPERATION_RATE_PER_MINUTE=30
MODELING_MAX_STEP_BYTES=52428800
MODELING_INTERACTIVE_TIMEOUT_MS=30000
MODELING_INTERACTIVE_TIMEOUT_SECONDS=30
MODELING_JOB_TIMEOUT_MS=180000
MODELING_PREVIEW_RETENTION_DAYS=30
MODELING_EXPORT_RETENTION_DAYS=7
MODELING_ARTIFACT_CLEANUP_INTERVAL_MS=60000
MODELING_ARTIFACT_CLEANUP_LEASE_MS=60000
MODELING_ARTIFACT_CLEANUP_RETRY_MS=60000
MODELING_ARTIFACT_CLEANUP_BATCH_SIZE=20
