# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://openvac:openvac@127.0.0.1:5432/openvac
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Model provider (server only)
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ALLOWED_HOSTS=api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_RESPONSES_MODEL=deepseek-v4-flash
DEEPSEEK_USER_PARTITION_SECRET=
DEEPSEEK_THINKING_MODE=disabled
MODEL_MAX_OUTPUT_TOKENS=4096
AGENT_AUTO_MAX_OUTPUT_TOKENS=4096
AGENT_DEEP_MAX_OUTPUT_TOKENS=8192
AGENT_AUTO_TIMEOUT_MS=120000
AGENT_DEEP_TIMEOUT_MS=180000
# Must remain greater than the longest run timeout. Interrupted runs become retryable failures.
AGENT_STALE_RUN_MS=210000
# Currency micros per 1,000,000 tokens (1 CNY = 1,000,000 micros).
# Required before an enabled admin model budget can allow calls.
MODEL_INPUT_COST_MICROS_PER_MILLION_TOKENS=
MODEL_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=
MODEL_PRICE_VERSION=

# Answer V3 live evaluation (run manually against the accepted staging SHA)
ANSWER_V3_EVAL_ADAPTER=src/evals/answer-v3/live-adapter.ts
ANSWER_V3_EVAL_GIT_SHA=
ANSWER_V3_EVAL_IMAGE_DIGEST=
ANSWER_V3_EVAL_BASE_URL=https://staging-openvac.openvac.cn/
ANSWER_V3_EVAL_OUTPUT_DIR=.artifacts/evals
ANSWER_V3_QWEN_JUDGE_MODEL=qwen-plus
ANSWER_V3_RUNTIME_EVIDENCE=
ANSWER_V3_RUNTIME_EVIDENCE_SHA256=

# Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_ALLOWED_HOSTS=dashscope.aliyuncs.com
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_VL_MAX_OUTPUT_TOKENS=2048
ALIBABA_EMBEDDING_MODEL=text-embedding-v4
ALIBABA_EMBEDDING_DIMENSIONS=1024
ALIBABA_WEB_SEARCH_ENABLED=false
ALIBABA_WEB_SEARCH_MODEL=qwen-plus
ALIBABA_WEB_SEARCH_COST_MICROS_PER_CALL=
ALIBABA_WEB_SEARCH_PRICE_VERSION=
ALIBABA_WEB_SEARCH_PER_USER_DAILY_LIMIT=5
ALIBABA_WEB_SEARCH_GLOBAL_DAILY_LIMIT=500
MODEL_ATTEMPT_PER_USER_DAILY_LIMIT=30
MODEL_ATTEMPT_GLOBAL_DAILY_LIMIT=1000
ALIBABA_WEB_SEARCH_ALLOWED_DOMAINS=cds.cern.ch,nist.gov,hse.gov.uk,iso.org,leybold.com,leybold.cn,pfeiffer-vacuum.com,edwardsvacuum.com,buschvacuum.com,atlascopco.com
ALIBABA_OCR_ENDPOINT=
ALIBABA_OCR_ALLOWED_DOCUMENT_HOSTS=

# Alibaba Cloud DirectMail
ALIBABA_DIRECTMAIL_ACCESS_KEY_ID=
ALIBABA_DIRECTMAIL_ACCESS_KEY_SECRET=
ALIBABA_DIRECTMAIL_SECURITY_TOKEN=
ALIBABA_DIRECTMAIL_ACCOUNT_NAME=no-reply@mail.openvac.cn
ALIBABA_DIRECTMAIL_REGION=cn-hangzhou
ALIBABA_DIRECTMAIL_ENDPOINT=dm.aliyuncs.com

# Alibaba Cloud DocMind (use a separate least-privilege credential)
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_SECURITY_TOKEN=

# Alibaba Cloud OSS
ALIBABA_OSS_REGION=
ALIBABA_OSS_ENDPOINT=
ALIBABA_OSS_BUCKET=
ALIBABA_OSS_ACCESS_KEY_ID=
ALIBABA_OSS_ACCESS_KEY_SECRET=
ALIBABA_OSS_SECURITY_TOKEN=

# Product policy
ANSWER_DAILY_LIMIT=20
BACKUP_RETENTION_DAYS=30
ADMIN_BOOTSTRAP_EMAIL=
PROBLEM_REPORT_NOTIFICATION_EMAIL=
# Optional public operations information. Empty values stay hidden on the site.
OPERATOR_NAME=
OPERATOR_ADDRESS=
PUBLIC_CONTACT_EMAIL=
LEGAL_COMPLAINT_EMAIL=
ICP_FILING_NUMBER=
GEN_AI_FILING_NUMBER=
ALLOW_DEVELOPMENT_MOCKS=true
WORKER_CONCURRENCY=2
WORKER_LEASE_HEARTBEAT_MS=60000
WORKER_MAX_OCR_POLLS=240
WORKER_MAX_OCR_AGE_MS=7200000

# Knowledge review automation (server only). Store only SHA-256 here; never the plaintext token.
KNOWLEDGE_REVIEW_AUTOMATION_TOKEN_SHA256=
